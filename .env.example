# Environment Variables Template for FRAUDSPOTTER
# Copy this file to .env and fill in your values. Do NOT commit .env to version control.

# Execution Environment: 'local' or 'colab'
ENVIRONMENT=local

# Random Seed for Reproducibility
RANDOM_SEED=42

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Paths
DATA_DIR=data
ARTIFACTS_DIR=artifacts
CONFIG_DIR=configs

# Hugging Face (Optional: for model hub distribution / gated downloads)
HF_TOKEN=
HF_REPO_ID=

# Kaggle API Credentials (Optional: for downloading WELFake/ISOT directly if using Kaggle CLI)
KAGGLE_USERNAME=
KAGGLE_KEY=

# Server Ports
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
STREAMLIT_PORT=8501

